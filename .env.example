# Copy to .env.production on the private host and replace every placeholder.
# Never commit the populated file.
APP_NAME=Personal AI Seller Hub
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
DATABASE_URL=postgresql+psycopg://seller_hub:REPLACE_PASSWORD@db:5432/seller_hub
POSTGRES_DB=seller_hub
POSTGRES_USER=seller_hub
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_VALUE
CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
ALLOWED_ORIGINS=https://seller-hub.example.internal
ALLOWED_HOSTS=seller-hub.example.internal
SELLER_HUB_PORT=80
RATE_LIMIT_PER_MINUTE=120
REDIS_URL=redis://redis:6379/0
SESSION_TTL_HOURS=24

# Background worker
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=5
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_SECONDS=10
WORKER_STALE_AFTER_SECONDS=1800
WORKER_CONCURRENCY=1

# Production monitoring (scheduled runner is opt-in)
SELLER_HUB_MONITORING_ENABLED=false
SELLER_HUB_ALERT_COOLDOWN_MINUTES=15

# Amazon Selling Partner API — configure only for a private test account.
AMAZON_SP_API_BASE_URL=https://sellingpartnerapi-eu.amazon.com
AMAZON_SP_API_REGION=eu-west-1
AMAZON_SP_API_MARKETPLACE_ID=A21TJRUUN4KGV
AMAZON_SP_API_ROLE_ARN=
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=
AMAZON_AWS_ACCESS_KEY_ID=
AMAZON_AWS_SECRET_ACCESS_KEY=
AMAZON_AWS_SESSION_TOKEN=
AMAZON_REQUEST_TIMEOUT_SECONDS=30
AMAZON_MAX_RETRIES=3

# Flipkart Seller API — configure only for a private test account.
FLIPKART_API_BASE_URL=https://api.flipkart.net
FLIPKART_APP_ID=
FLIPKART_APP_SECRET=
FLIPKART_REQUEST_TIMEOUT_SECONDS=30
FLIPKART_MAX_RETRIES=3

# Optional notification providers (never commit real credentials).
SELLER_HUB_SMTP_HOST=
SELLER_HUB_SMTP_PORT=587
SELLER_HUB_SMTP_FROM=
SELLER_HUB_SMTP_USERNAME=
SELLER_HUB_SMTP_PASSWORD=
SELLER_HUB_WHATSAPP_WEBHOOK_URL=
SELLER_HUB_WHATSAPP_WEBHOOK_TOKEN=
